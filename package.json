{
  "name": "yos",
  "version": "0.1.10",
  "type": "module",
  "description": "YOS persistent AI Agent runtime",
  "main": "cli/yos.js",
  "bin": {
    "yos": "./cli/yos.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js || true",
    "prepublishOnly": "npm run verify",
    "release:pack": "node scripts/build-release.mjs",
    "test": "npm run test:jest && npm run test:node",
    "pretest:jest": "node scripts/install-skill-deps.js",
    "test:jest": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:node": "node scripts/run-node-tests.js",
    "verify": "node scripts/verify.js"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "autonomous"
  ],
  "author": "YOS Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "js-yaml": "^4.3.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.3.0"
  }
}
